# Deployment Configuration Template
# Copy this file to .env and fill in your values

# Option 1: Using Private Key (Recommended for Hardhat)
# Get your private key from your wallet (e.g., MetaMask > Account Details > Export Private Key)
DEPLOYER_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Option 2: Using Encrypted Keystore File (Alternative)
# Path to your encrypted keystore JSON file
# MNEMONIC_FILE_PATH=/path/to/your/keystore.js

# Network RPC URLs
# Base Sepolia (Testnet)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Base Mainnet
BASE_MAINNET_RPC=https://mainnet.base.org

# Polygon
POLYGON_RPC=https://polygon-rpc.com

# Arbitrum
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc

# Optimism
OPTIMISM_RPC=https://mainnet.optimism.io

# Ethereum Mainnet
MAINNET_RPC=https://eth.llamarpc.com

# Optional: Block Explorer API Keys (for contract verification)
# BASESCAN_API_KEY=your_basescan_key
# ETHERSCAN_API_KEY=your_etherscan_key
# POLYGONSCAN_API_KEY=your_polygonscan_key
